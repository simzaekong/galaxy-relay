{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galaxy-relay-example",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "ratelimits": [
    {
      "name": "PAIR_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "API_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "VAPID_SUBJECT": "mailto:operator@example.com",
    "FCM_PROJECT_ID": "galaxy-relay-example"
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CAMERA",
        "class_name": "CameraRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "camera-v1",
      "new_sqlite_classes": [
        "CameraRoom"
      ]
    }
  ]
}
